// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ================= ENUMS =================
enum Role {
  USER
  MANAGER
  HR_MANAGER
  ADMIN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum LeaveType {
  SICK
  CASUAL
  VACATION
}

enum LeaveStatus {
  PENDING
  APPROVED_BY_MANAGER
  APPROVED_BY_HR
  REJECTED
}

enum PayrollStatus {
  PENDING
  PAID
}

// ================= MODELS =================

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  budget    Decimal  @db.Decimal(12, 2)
  location  String   @db.VarChar(150)
  createdAt DateTime @default(now()) @map("created_at")

  employees Employee[]

  @@map("departments")
}

model JobTitle {
  id        Int      @id @default(autoincrement())
  title     String   @unique @db.VarChar(100)
  salaryMin Decimal  @map("salary_range_min") @db.Decimal(10, 2)
  salaryMax Decimal? @map("salary_range_max") @db.Decimal(10, 2)

  employees Employee[]

  @@map("job_titles")
}

model Employee {
  id           Int            @id @default(autoincrement())
  firstName    String         @map("first_name") @db.VarChar(50)
  lastName     String         @map("last_name") @db.VarChar(50)
  email        String         @unique @db.VarChar(150)
  password     String         @db.VarChar(255)
  role         Role
  departmentId Int            @map("department_id")
  jobTitleId   Int            @map("job_title_id")
  managerId    Int?           @map("manager_id")
  status       EmployeeStatus @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at")

  // Quan hệ Foreign Keys
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jobTitle   JobTitle   @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)

  // Quan hệ Self-referencing (Quản lý trực tiếp)
  manager      Employee?  @relation("ManagerToSubordinates", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates Employee[] @relation("ManagerToSubordinates")

  // Quan hệ với luồng nghỉ phép
  leaves              LeaveRequest[] @relation("EmployeeLeaves")
  approvedLeavesAsMgr LeaveRequest[] @relation("ManagerApprovals")
  approvedLeavesAsHR  LeaveRequest[] @relation("HRApprovals")

  // Quan hệ với bảng lương
  payrolls Payroll[]

  // Quan hệ với nhật ký audit (actor thực hiện thay đổi)
  auditLogs AuditLog[]

  @@map("employees")
}

model LeaveRequest {
  id                  Int         @id @default(autoincrement())
  employeeId          Int         @map("employee_id")
  startDate           DateTime    @map("start_date") @db.Date
  endDate             DateTime    @map("end_date") @db.Date
  type                LeaveType
  status              LeaveStatus @default(PENDING)
  reason              String?     @db.Text
  approvedByManagerId Int?        @map("approved_by_manager_id")
  approvedByHrId      Int?        @map("approved_by_hr_id")
  // Quan hệ Foreign Keys
  employee            Employee    @relation("EmployeeLeaves", fields: [employeeId], references: [id], onDelete: Cascade)
  approvedByManager   Employee?   @relation("ManagerApprovals", fields: [approvedByManagerId], references: [id])
  approvedByHr        Employee?   @relation("HRApprovals", fields: [approvedByHrId], references: [id])

  @@map("leave_requests")
}

model Payroll {
  id             Int           @id @default(autoincrement())
  employeeId     Int           @map("employee_id")
  baseSalary     Decimal       @map("base_salary") @db.Decimal(10, 2)
  bonuses        Decimal       @default(0) @db.Decimal(10, 2)
  deductions     Decimal       @default(0) @db.Decimal(10, 2)
  // Cột tính toán tự động ở Postgres (GENERATED ALWAYS AS ... STORED).
  // Không có @default để Prisma Client không bao giờ ghi giá trị cho cột này.
  totalSalary    Decimal?      @map("total_salary") @db.Decimal(10, 2)
  payPeriodStart DateTime      @map("pay_period_start") @db.Date
  payPeriodEnd   DateTime      @map("pay_period_end") @db.Date
  status         PayrollStatus @default(PENDING)
  createdAt      DateTime      @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("payrolls")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   Int?     @map("actor_id")
  action    String   @db.VarChar(20)
  tableName String   @map("table_name") @db.VarChar(50)
  recordId  Int      @map("record_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  timestamp DateTime @default(now())

  // actor_id có thể NULL nếu thay đổi do hệ thống tự chạy (không có user context)
  actor Employee? @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}
